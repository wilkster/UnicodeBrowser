;@Ahk2Exe-SetName Unicode Browser
;@Ahk2Exe-SetDescription Unicode Browser
;@Ahk2Exe-Set Comments, Unicode and Emoji Browser
;@Ahk2Exe-SetVersion 2026.11.11
;@Ahk2Exe-SetCopyright Copyright (c) 2026 Tom Wilkason
;@Ahk2Exe-SetOrigFilename UnicodeBrowser.exe
;@Ahk2Exe-SetMainIcon Tray.ico

#Requires AutoHotkey v2.1-
#SingleInstance Force
#DllLoad "ole32.dll"
#DllLoad "d2d1.dll"
#DllLoad "dwrite.dll"
#Include "clsD2D.ahk2"
TraySetIcon(A_ScriptDir "\tray.ico")
; Unicode / emoji browser
; - One Direct2D HwndRenderTarget draws the visible cells only (virtual grid), so
;   color emoji render via DrawText + ENABLE_COLOR_FONT and scrolling stays cheap.
; - Nothing is shown until the filter box has text.
; - Data (downloaded once after asking permission, cached in .\UnicodeData\ - delete the folder to refresh):
;     emoji-test.txt   emoji names, groups, ZWJ/flag/skin-tone sequences
;     UnicodeData.txt  names for every individually named character
;     Blocks.txt       block names (used as the "group" for non-emoji)
;     CLDR annotations keywords + spoken names (en) from unicode-org/cldr-json
; - Filter: words are ANDed and match name, keywords, group or the character itself.
;   A term starting with "u+" matches code points, e.g.  u+1f60   or   arrow u+219
; - Click selects, double-click or Enter copies. Mouse wheel scrolls over the grid.
; - Group list (left): every group/block that has hits in the current search, with counts. Click one to restrict
;   the grid to it. With an empty filter it lists everything, so a group can be browsed without typing.
/* TODO
 * x Detect when restored what the prior window was that had focus, then a RMB will send the key to that window
 * x Track recent selections that were copied to the clipboard and have a button to show them vs filtered. Save them to the INI file, max up to 120.
 * x Clear button ✖ next to search window (on right) to do a ctrl-backspace (or ⎚)
 * x Before downloading any txt files prompt the user for permission, show splash screen while downloading
 * - 
*/

/**
 * Static data store for the browser. Loads, caches and searches Unicode/emoji data.
 * Entries are held in parallel arrays (Ch, Nm, Gr, Kw, Hx, Fl, Sr) addressed by the same entry index.
 * Ch = character string, Nm = display name, Gr = group/block, Kw = keywords, Hx = "U+XXXX" code point text,
 * Fl = flag bits (1 = skin-tone variant, 2 = combining mark), Sr = lowercased combined search string (character, name, keywords, group).
 * Idx maps a character (VS16 stripped) to its entry index.
 */
struct RECT {
   left  : Int32
   top   : Int32
   right : Int32
   bottom: Int32
}
Class UniData {
   Static Dir := A_ScriptDir "\UnicodeData"
   Static Ch := [], Nm := [], Gr := [], Kw := [], Hx := [], Fl := [], Sr := []
   Static All := []   ; every entry index (1..n): the default candidate list for Search
   Static Idx := Map()
   Static VS16 := Chr(0xFE0F)

   ; Fl bit 1 = skin-tone variant, bit 2 = combining mark (drawn on a dotted circle)

   ; Data files: [cache file name, URL, required]. Optional files only improve names/keywords/groups.
   Static Sources := [
      ["emoji-test.txt", "https://www.unicode.org/Public/emoji/latest/emoji-test.txt", true],
      ["UnicodeData.txt", "https://www.unicode.org/Public/UCD/latest/ucd/UnicodeData.txt", true],
      ["Blocks.txt", "https://www.unicode.org/Public/UCD/latest/ucd/Blocks.txt", false],
      ["annotations-en.json", "https://raw.githubusercontent.com/unicode-org/cldr-json/main/cldr-json/cldr-annotations-full/annotations/en/annotations.json", false],
      ["annotations-derived-en.json", "https://raw.githubusercontent.com/unicode-org/cldr-json/main/cldr-json/cldr-annotations-derived-full/annotationsDerived/en/annotations.json", false]
   ]

   /**
    * Download (first run only, with the user's permission) and parse every data source, then build the combined
    * search strings. Shows a tooltip while parsing. Call once before using Search.
    * @returns {unset?} Exits the app if a required data file is not available
    */
   Static Load() {
      DirCreate(this.Dir)
      need := []
      For s in this.Sources {
         If this.Cached(s[1]) = ""
            need.Push(s)
      }
      If need.Length
         this.DownloadAll(need)   ; asks first, shows status; exits the app if a required file is unavailable

      ToolTip("Loading Unicode data...")
      fEmoji := this.Cached("emoji-test.txt")
      fUni := this.Cached("UnicodeData.txt")
      fBlk := this.Cached("Blocks.txt")
      fAnn := this.Cached("annotations-en.json")
      fDer := this.Cached("annotations-derived-en.json")

      this.LoadEmoji(fEmoji)
      this.LoadUnicodeData(fUni, fBlk)
      For f in [fAnn, fDer] {
         If f != ""
            this.ApplyAnnotations(f)
      }
      Loop this.Ch.Length {
         i := A_Index
         this.Sr.Push(StrLower(this.Ch[i] " " this.Nm[i] " " this.Kw[i] " " this.Gr[i]))
         this.All.Push(i)
      }
      ToolTip()
   }

   /**
    * Path of a cached data file.
    * @param {String} name File name inside the cache folder (UniData.Dir)
    * @returns {String} Full path, or "" if the file is missing or empty
    */
   Static Cached(name) {
      f := this.Dir "\" name
      Return FileExist(f) && FileGetSize(f) > 0 ? f : ""
   }

   /**
    * Ask permission, then download the missing data files one at a time while a splash window shows the
    * status of each (with elapsed seconds, so a slow network is visibly still working). The splash has a
    * Cancel button that aborts the current download and skips the rest.
    * If permission is refused or a required file could not be obtained, the app exits.
    * Declining when only optional files are missing just continues without them.
    * @param {Array} need Entries from Sources that are not cached yet
    * @returns {unset?}
    */
   Static DownloadAll(need) {
      names := "", anyRequired := false
      For s in need {
         names .= "`n   " s[1] (s[3] ? "" : "   (optional)")
         If s[3]
            anyRequired := true
      }
      msg := "Unicode Browser needs to download " (need.Length = 1 ? "this data file" : "these data files")
         . " (about 4 MB in total on a first run) from unicode.org and github.com:`n" names
         . "`n`nThey will be saved in:`n" this.Dir "`n`nDownload now?"
      If MsgBox(msg, "Unicode Browser", "YesNo Icon?") != "Yes" {
         If anyRequired {
            MsgBox("The required Unicode data files are not available, so Unicode Browser cannot start.", "Unicode Browser", "Iconx")
            ExitApp
         }
         Return
      }

      ; Splash window: one row per file with its status
      g := Gui("+AlwaysOnTop -SysMenu", "Unicode Browser - Downloading")
      g.BackColor := UniBrowser.hxClrBack
      g.SetFont("s10 cE6E6E6", "Segoe UI")
      g.MarginX := 16, g.MarginY := 12
      g.AddText("w500", "Downloading Unicode data. This can take a while on a slow connection, please wait...")
      stat := []
      For s in need {
         g.AddText("xm y+8 w230", s[1])
         stat.Push(g.AddText("x+10 yp w260", "Waiting"))
      }
      btn := g.AddButton("xm y+16 w90", "Cancel")
      state := {cancel: false}
      btn.OnEvent("Click", (*) => state.cancel := true)
      try DllCall("dwmapi\DwmSetWindowAttribute", "Ptr", g.Hwnd, "Int", 20, "Int*", 1, "Int", 4, "Int")   ; dark title bar
      try DllCall("uxtheme\SetWindowTheme", "Ptr", btn.Hwnd, "Str", "DarkMode_Explorer", "Ptr", 0)
      g.Show()

      For i, s in need {
         If state.cancel {
            stat[i].Text := "Skipped"
            Continue
         }
         stat[i].Text := "Downloading... 0 s"
         ok := this.HttpGet(s[2], this.Dir "\" s[1], stat[i], state)
         stat[i].Text := ok ? "Done" : (state.cancel ? "Cancelled" : (s[3] ? "Failed" : "Failed (optional, skipped)"))
      }
      g.Destroy()

      bad := ""
      For s in need {
         If s[3] && this.Cached(s[1]) = ""
            bad .= "`n   " s[1]
      }
      If bad != "" {
         MsgBox((state.cancel ? "The download was cancelled." : "The download failed. Check your network connection and try again.")
            . "`n`nRequired files missing:" bad, "Unicode Browser", "Iconx")
         ExitApp
      }
   }

   /**
    * Download a URL to a file without blocking the GUI: the request is asynchronous and the wait loop uses
    * Sleep, so the splash stays responsive (Cancel works) and no fixed overall time limit applies.
    * Per-operation network timeouts are generous for slow links. The file is only written once the whole
    * response has arrived, and removed again on failure.
    * @param {String} url Source URL
    * @param {String} file Destination path
    * @param {Gui.Text} ctl Status control updated with the elapsed seconds
    * @param {Object} state Object whose cancel property is set to true by the Cancel button
    * @returns {Boolean} True if the file was downloaded and saved
    */
   Static HttpGet(url, file, ctl, state) {
      t0 := A_TickCount, last := 0
      try {
         whr := ComObject("WinHttp.WinHttpRequest.5.1")
         whr.SetTimeouts(30000, 30000, 60000, 120000)   ; resolve, connect, send, receive (ms)
         whr.Open("GET", url, true)
         whr.Send()
         While !whr.WaitForResponse(0) {
            If state.cancel {
               whr.Abort()
               Return false
            }
            If (sec := (A_TickCount - t0) // 1000) != last {
               last := sec
               ctl.Text := "Downloading... " sec " s"
            }
            Sleep(100)
         }
         If whr.Status != 200
            Return false
         body := whr.ResponseBody   ; SAFEARRAY of bytes
         size := body.MaxIndex() + 1
         If size <= 0
            Return false
         pData := NumGet(ComObjValue(body), 8 + A_PtrSize, "Ptr")   ; SAFEARRAY.pvData
         f := FileOpen(file, "w")
         f.RawWrite(pData, size)
         f.Close()
         Return true
      }
      Try FileDelete(file)
      Return false
   }

   /**
    * Append one entry to every parallel array and register it in the Idx lookup.
    * @param {String} key Lookup key stored in Idx (the character with VS16 removed)
    * @param {String} ch Character or sequence to display and copy
    * @param {String} name Display name
    * @param {String} group Emoji group or Unicode block name (may be empty)
    * @param {String} hx Space-separated code points, e.g. "U+1F600"
    * @param {Integer} fl Flag bits: 1 = skin-tone variant, 2 = combining mark
    * @returns {unset?}
    */
   Static Add(key, ch, name, group, hx, fl) {
      this.Ch.Push(ch)
      this.Nm.Push(name)
      this.Gr.Push(group)
      this.Kw.Push("")
      this.Hx.Push(hx)
      this.Fl.Push(fl)
      this.Idx[key] := this.Ch.Length
   }

   /**
    * Parse emoji-test.txt. Only fully-qualified entries are added, using the file's `# group:` headers
    * as the group. Skin-tone modifier code points (U+1F3FB-U+1F3FF) set flag bit 1.
    * @param {String} file Path to emoji-test.txt
    * @returns {unset?}
    */
   Static LoadEmoji(file) {
      group := ""
      For line in StrSplit(FileRead(file, "UTF-8"), "`n", "`r") {
         If line = ""
            Continue
         If SubStr(line, 1, 1) = "#" {
            If RegExMatch(line, "^# group: (.+)$", &g)
               group := g[1]
            Continue
         }
         If !RegExMatch(line, "^([0-9A-F]+(?: [0-9A-F]+)*)\s*;\s*(\S+)\s*#\s*\S+\s+E[\d.]+\s+(.+)$", &m)
            || m[2] != "fully-qualified"
            Continue
         s := "", hx := "", fl := 0
         For h in StrSplit(m[1], " ") {
            cp := Integer("0x" h)
            s .= Chr(cp)
            hx .= (hx = "" ? "" : " ") . Format("U+{:04X}", cp)
            If cp >= 0x1F3FB && cp <= 0x1F3FF
               fl |= 1
         }
         this.Add(StrReplace(s, this.VS16), s, m[3], group, hx, fl)
      }
   }

   /**
    * Parse UnicodeData.txt and add every individually named, non-control character not already present.
    * Characters already added from emoji-test keep their short name; the formal name becomes a keyword.
    * Combining marks (category M*) set flag bit 2. The group is taken from Blocks.txt when available.
    * @param {String} file Path to UnicodeData.txt
    * @param {String} blkFile Path to Blocks.txt, or "" to leave the group blank
    * @returns {unset?}
    */
   Static LoadUnicodeData(file, blkFile) {
      bLo := [], bHi := [], bNm := []
      If blkFile != "" {
         For line in StrSplit(FileRead(blkFile, "UTF-8"), "`n", "`r") {
            If RegExMatch(line, "^([0-9A-F]+)\.\.([0-9A-F]+);\s*(.+)$", &b) {
               bLo.Push(Integer("0x" b[1]))
               bHi.Push(Integer("0x" b[2]))
               bNm.Push(Trim(b[3]))
            }
         }
      }
      bi := 1
      Loop Parse FileRead(file, "UTF-8"), "`n", "`r" {
         If !RegExMatch(A_LoopField, "^([0-9A-F]+);([^;]*);(\w\w);", &m)
            Continue
         name := m[2], cat := m[3]
         If SubStr(name, 1, 1) = "<" || SubStr(cat, 1, 1) = "C"
            Continue   ; ranges, controls, format, private use, surrogates
         cp := Integer("0x" m[1])
         ch := Chr(cp)
         If this.Idx.Has(ch) {
            ; already added from emoji-test: keep its short name, add the formal name as a keyword
            this.Kw[this.Idx[ch]] .= " " StrTitle(name)
            Continue
         }
         group := ""
         If bNm.Length {
            While bi < bNm.Length && cp > bHi[bi]
               bi++
            If cp >= bLo[bi] && cp <= bHi[bi]
               group := bNm[bi]
         }
         this.Add(ch, ch, StrTitle(name), group, Format("U+{:04X}", cp), SubStr(cat, 1, 1) = "M" ? 2 : 0)
      }
   }

   /**
    * Append CLDR keywords and spoken (tts) names from an annotations JSON file to matching entries.
    * Entries are matched by character (VS16 stripped); unknown characters are ignored.
    * @param {String} file Path to a CLDR annotations.json file
    * @returns {unset?}
    */
   Static ApplyAnnotations(file) {
      txt := FileRead(file, "UTF-8")
      pos := 1
      While pos := RegExMatch(txt, '"([^"\\]+)":\s*\{\s*"default":\s*\[([^\]]*)\],\s*"tts":\s*\[\s*"([^"]*)"', &m, pos) {
         pos += m.Len
         key := StrReplace(m[1], this.VS16)
         If !this.Idx.Has(key)
            Continue
         kws := " " m[3]
         p2 := 1
         While p2 := RegExMatch(m[2], '"([^"]*)"', &k, p2) {
            kws .= " " k[1]
            p2 += k.Len
         }
         this.Kw[this.Idx[key]] .= kws
      }
   }

   /**
    * Find entries matching the search text. Space-separated terms are ANDed; an uppercase OR between terms
    * starts an alternative, so "heart red OR star" = (heart AND red) OR star. Plain terms must appear in the
    * search string (character, name, keywords, group); terms starting with "u+" must appear in the code point text.
    * @param {String} text Search terms, e.g. "arrow u+219" or "cat OR dog"
    * @param {Boolean} [hideSkin=false] Skip skin-tone variants
    * @param {Array} [cand] Entry indexes to search within, in data order (default: every entry). Used to narrow
    *    the previous results while typing; the array is only read.
    * @returns {Array} Entry indexes of all matches, in data order
    */
   Static Search(text, hideSkin := false, cand?) {
      groups := [], tx := [], hx := []
      For t in StrSplit(text, " ") {   ; split before lowering: only uppercase OR is an operator
         If t == "OR" {
            If tx.Length || hx.Length
               groups.Push([tx, hx]), tx := [], hx := []
            Continue
         }
         t := StrLower(t)             ; Sr is pre-lowered, so case-sensitive InStr is safe and faster
         If t = ""
            Continue
         If SubStr(t, 1, 2) = "u+"
            hx.Push(StrUpper(t))      ; Hx entries are stored uppercase
         Else
            tx.Push(t)
      }
      If tx.Length || hx.Length || !groups.Length
         groups.Push([tx, hx])        ; last group; empty when there are no terms at all (matches everything)
      res := []
      Sr := this.Sr, Hxs := this.Hx, Fl := this.Fl
      For i in cand ?? this.All {
         s := Sr[i]
         If hideSkin && (Fl[i] & 1)
            Continue
         For g in groups {
            ok := true
            ; Wildcard search would be done here
            For t in g[1] {
               If !InStr(s, t, true) {
                  ok := false
                  Break
               }
            }
            If ok {
               For t in g[2] {
                  If !InStr(Hxs[i], t, true) {
                     ok := false
                     Break
                  }
               }
            }
            If ok {
               res.Push(i)
               Break   ; one matching group is enough
            }
         }
      }
      Return res
   }
}
/**
 * GUI and Direct2D grid renderer for the Unicode browser.
 * A child window (grid) hosts one ID2D1HwndRenderTarget that draws only the visible cells (virtual grid).
 * State: res = matching entry indexes, sel = selected position in res (0 = none), top = first visible row,
 * cols/rows/page = grid geometry, cellW/cellH = cell size in pixels.
 */
class UniBrowser {
   static dpi := 96, sc := 96 / 72, lw := 1, starting := true   ; dpi/sc/lw are set from the active monitor in Start, then kept current by OnDpiChanged
   static ini := A_ScriptDir "\UnicodeBrowser.ini"
   static main := 0, grid := 0, edFilter := 0, btnClear := 0, btnBack := 0, btnForward := 0
   static chkSkin := 0, chkBounds := 0, chkRecents := 0, txtInfo := 0, txtMetrics := 0, btnCopy := 0
   static tmr := 0
   static searchHistory := [], historyPos := 0, navigatingHistory := false
   static recent := [], maxRecent := 100   ; copy history: entry indexes, oldest first, latest at the end
   static lstGroup := 0, grpKeys := [""], grpSel := "", hits := [], filterText := ""   ; hits = search hits before the group filter
   static lastText := "", lastSkin := -1, allHits := Map(), grpSig := ""   ; text/skin that produced hits, empty-search hits per skin setting, group list contents
   static _d2d := 0, _dw := 0, rt := 0, br := 0, fmt := 0, fmtEmoji := 0, rtW := 0, rtH := 0
   static tipTmr := 0, tipT0 := 0, tipShown := false
   static rendering := false, again := false   ; Render re-entrancy guard
   static lc := Map(), lcH := 0                 ; text layout cache: entry index -> {lay, m}, built in a cellH x cellH box
   static rect := D2D1_RECT_F()
   ; Grid theme colors as 0xRRGGBB. _Color builds each one once as a D2D1_COLOR_F, ready for the D2D calls.
   static clrBack       := this._FloatColor(this.hxClrBack := "0x202020")   ; grid background
   static clrTxt        := this._FloatColor(this.hxclrTxt := "0xE6E6E6")   ; grid background
   static clrCellBorder := this._FloatColor("0x3A3A3A")   ; cell outlines
   static clrSelFill    := this._FloatColor("0x264F78")   ; selected cell fill
   static clrSelBorder  := this._FloatColor("0x0078D7")   ; selected cell outline
   static clrGlyph      := this._FloatColor("0xEBEBEB")   ; glyph color (color emoji ignore it)
   static clrBounds     := this._FloatColor("0xa35027")   ; text-box outline
   static clrEntry      := "0x2D2D2D"
   static res           := [],   sel     := 0, top := 0, cols := 1, rows := 0, page := 1
   static cellW         := 56.0, cellH   := 56
   static FontSize      := 26
   Static BlockSize     := 56
   Static Font          := "Segoe UI"
   ; Static Font          := "Symbola"
   Static EmojiFont     := "Segoe UI Emoji"   ; primary family for emoji-range strings (skips the fallback search)
   /**
    * Scale a 72-dpi design value to the current screen DPI.
    * @param {Number} n Unscaled size
    * @returns {Integer} Scaled size in pixels
    */
   static S(n) => Round(n * this.sc)

   /**
    * Effective DPI of the monitor a window is on (the active window's monitor when hwnd is 0).
    * Falls back to the primary monitor, then to A_ScreenDPI.
    * @param {Integer} [hwnd=0] Window handle
    * @param {VarRef} [hMon] Receives the monitor handle
    * @returns {Integer}
    */
   static GetDPI(hwnd := 0, &hMon := 0) {
      hMon := DllCall("MonitorFromWindow", "Ptr", hwnd || WinExist("A"), "UInt", 1, "Ptr")   ; MONITOR_DEFAULTTOPRIMARY
      try {
         if !DllCall("shcore\GetDpiForMonitor", "Ptr", hMon, "Int", 0, "UInt*", &dx := 0, "UInt*", &dy := 0, "Int")   ; MDT_EFFECTIVE_DPI
            return dx
      }
      return A_ScreenDPI
   }

   /**
    * Store the DPI and derive the 72-dpi scale factor and the D2D stroke width (whole pixels) from it.
    * @param {Integer} dpi
    * @returns {unset?}
    */
   static SetDPI(dpi) {
      this.dpi := dpi, this.sc := dpi / 72
      this.lw := Max(1, dpi // 96)
   }

   /**
    * Work area of a monitor.
    * @param {Integer} hMon Monitor handle
    * @returns {Object} {l, t, r, b} in virtual-screen pixels
    */
   static MonitorWork(hMon) {
      mi := Buffer(40, 0)
      NumPut("UInt", 40, mi)
      DllCall("GetMonitorInfoW", "Ptr", hMon, "Ptr", mi)
      return {l: NumGet(mi, 20, "Int"), t: NumGet(mi, 24, "Int"), r: NumGet(mi, 28, "Int"), b: NumGet(mi, 32, "Int")}
   }

   /**
    * WM_DPICHANGED handler. AutoHotkey 2.1 is per-monitor aware and rescales the window, the controls and their
    * fonts itself, so this only keeps the script's own pixel math current (DPI, scale factor, D2D text formats).
    * There is deliberately no return value, so AutoHotkey's own handling still runs afterwards.
    * @param {Gui} gui Main GUI
    * @param {Integer} wParam Low word = new DPI
    * @param {Integer} lParam Pointer to the suggested window RECT
    * @param {Integer} msg Message number
    * @returns {unset?}
    */
   static OnDpiChanged(gui, wParam, lParam, msg) {
      this.ApplyDPI(wParam & 0xFFFF)
      if !this.starting   ; Start does its own final layout
         SetTimer(this.AfterDpiChange.Bind(this), -1)
   }

   /**
    * Switch the script's pixel math to a new DPI: scale factor, stroke width and the D2D text formats
    * (which also drops the cached text layouts). Does nothing if the DPI is unchanged.
    * @param {Integer} dpi New DPI
    * @returns {Boolean} True if the DPI changed
    */
   static ApplyDPI(dpi) {
      if !dpi || dpi = this.dpi
         return false
      this.SetDPI(dpi)
      if this.fmt
         this.MakeFormat()
      return true
   }

   /**
    * Runs once AutoHotkey has finished its own DPI handling (window resized, controls and fonts rescaled):
    * reapply the minimum size and window icon for the new DPI, then place every control again from the design
    * values. Arrange computes absolute pixel positions, so whatever AutoHotkey did to the controls' positions and
    * sizes in between is simply overwritten; only its font rescaling is kept.
    * @returns {unset?}
    */
   static AfterDpiChange() {
      this.main.Opt("+MinSize640x400")
      ; this.SetWindowIcon(this.main.Hwnd, A_ScriptDir "\tray.ico")
      this.Arrange()
      this.ShowInfo()
      this.Render()
   }

   /**
    * Load the data, build the GUI and grid window, register message handlers and show the window.
    * @returns {unset?}
    */
   static Start() {
      this.FontSize := Max(10, Min(80, Integer(IniRead(this.ini, "Settings", "Font Size", 26))))
      this.BlockSize := 56 / 26 * this.FontSize

      UniData.Load()
      this.LoadRecent()
      this.tmr := ObjBindMethod(this, "Refilter")
      this.SetDPI(this.GetDPI(0, &hMon))   ; DPI of the monitor the active window is on (not A_ScreenDPI)

      this.InitDark() ; Color
      this.Gui := g := this.main := Gui("+Resize +DPIScale +MinSize640x400", "Unicode Browser")
      ; this.SetWindowIcon(g.Hwnd, A_ScriptDir "\tray.ico")
      g.BackColor := this.hxClrBack ; Color
      this.DarkTitle(g.Hwnd)

      g.SetFont("s16 bold q5 C" this.hxclrTxt, this.Font)
      pad             := 8,                   navW    := 28, navGap := 3
      forwardX        := pad + navW + navGap, filterX := pad + 2 * (navW + navGap)
      this.btnBack    := g.AddButton("x" pad " y" pad " w" navW " h" 28 " -Wrap", "🡨") ; ◀ 🡠
      this.btnForward := g.AddButton("x" forwardX " y" pad " w" navW " h" 28 " -Wrap", "🡪") ; ▶ 🡢
      this.edFilter   := g.AddEdit("x" filterX " y" pad " w" 300 " h" 28 " Background" this.clrEntry)
      SendMessage(0x1501, true, StrPtr("Search name, keyword, group or u+hex"), this.edFilter)   ; EM_SETCUEBANNER
      this.btnClear := g.AddButton("x" (filterX + 300 + navGap) " y" pad " w" navW " h" 28 " -Wrap", "✖")   ; positioned in OnSize

      g.SetFont("s10 Norm q5 C" this.hxclrTxt, this.Font)
      this.chkSkin         := g.AddCheckbox("x0 y0 w" 100, "Hide skin tones")
      this.chkSkin.Value   := IniRead(this.ini,"Settings","Hide Skin Tones", true)
      this.chkBounds       := g.AddCheckbox("x0 y0 w" 100, "Show bounds")
      this.chkBounds.Value := IniRead(this.ini,"Settings","Show Bounds", true)
      this.chkRecents      := g.AddCheckbox("x0 y0 w" 92, "Show recents")
      this.lstGroup        := g.AddListBox("x0 y0 w" 170 " h" 200 " Background" this.clrEntry " +0x100")   ; 0x100 = LBS_NOINTEGRALHEIGHT
      this.txtInfo         := g.AddText("x0 y0 w" 75 " h" 60 " 0x80")   ; SS_NOPREFIX: keep '&'
      this.txtInfo.Value   := "Please Wait..."
      this.txtMetrics      := g.AddText("x0 y0 w" 230 " h" 60 " 0x80")
      this.btnCopy         := g.AddButton("Default x0 y0 w" 80 " h" 30, "Copy")
      this.Dark(this.edFilter.Hwnd, "DarkMode_CFD") ; Color
      this.Dark(this.btnClear.Hwnd) ; Color
      this.Dark(this.btnBack.Hwnd) ; Color
      this.Dark(this.btnForward.Hwnd) ; Color
      this.Dark(this.chkSkin.Hwnd) ; Color
      this.Dark(this.btnCopy.Hwnd) ; Color
      this.Dark(this.chkBounds.Hwnd) ; Color
      this.Dark(this.chkRecents.Hwnd) ; Color
      this.Dark(this.lstGroup.Hwnd) ; Color
      this.edFilter.OnEvent("Change", this.OnFilter.Bind(this))
      this.btnClear.OnEvent("Click", this.OnClearClick.Bind(this))
      this.btnBack.OnEvent("Click", this.NavigateHistory.Bind(this, -1))
      this.btnForward.OnEvent("Click", this.NavigateHistory.Bind(this, 1))
      this.txtInfo.OnEvent("Click", this.pickGroup.Bind(this))
      this.txtInfo.OnEvent("ContextMenu", this.getInfo.Bind(this))
      this.UpdateHistoryButtons()
      this.chkSkin.OnEvent("Click", this.Refilter.Bind(this))
      this.btnCopy.OnEvent("Click", this.CopySelected.Bind(this))
      this.chkBounds.OnEvent("Click", this.OnBounds.Bind(this))
      this.chkRecents.OnEvent("Click", this.OnRecents.Bind(this))
      this.lstGroup.OnEvent("Change", this.OnGroup.Bind(this))
      g.OnEvent("Size", this.OnSize.Bind(this))
      g.OnMessage(0x02E0, this.OnDpiChanged.Bind(this))   ; WM_DPICHANGED
      g.OnEvent("Close", (*) => ExitApp())

      ; Gui has no +VScroll option (that is control-only). Use the raw WS_VSCROLL style (0x200000) so the
      ; non-client scrollbar exists from creation; SetScrollInfo alone adds it without recalculating the frame.
      this.grid := Gui("-Caption +Parent" g.Hwnd " -DPIScale +0x200000")   ; +0x200000 = WS_VSCROLL, present from creation
      this.grid.BackColor := this.hxClrBack   ; fallback so any default erase is dark, never white
      this.Dark(this.grid.Hwnd)   ; dark scrollbar
      this.grid.OnMessage(0x000F, this.OnPaint.Bind(this))    ; WM_PAINT
      this.grid.OnMessage(0x0014, this.OnErase.Bind(this))    ; WM_ERASEBKGND
      this.grid.OnMessage(0x0115, this.OnVScroll.Bind(this))  ; WM_VSCROLL
      this.grid.OnMessage(0x0201, this.OnClick.Bind(this))    ; WM_LBUTTONDOWN
      this.grid.OnMessage(0x0203, this.CopySel.Bind(this))    ; left dbl click
      this.grid.OnMessage(0x0204, this.CopySel.Bind(this))    ; right click
      this.grid.Show("x0 y" 44 " w" 400 " h" 300 " NoActivate")   ; after the handlers: no unhandled first paint/erase
      ; Create the window on the active monitor (hidden), then center it in that monitor's work area
      ; LoadDim returns DPI-independent units: with +DPIScale, Show scales them by the window's own DPI
      w := this.LoadDim("Width", 960, 480), h := this.LoadDim("Height", 660, 300)
      wa := this.MonitorWork(hMon)
      g.Show("Hide x" wa.l " y" wa.t " w" w " h" h)
      g.Show("Hide w" w " h" h)   ; again: if that move changed the window's DPI, the first size was scaled for the old one
      g.Opt("+MinSize640x400")
      WinGetPos(, , &ww, &wh, g.Hwnd)
      g.Show("x" wa.l + (wa.r - wa.l - ww) // 2 " y" wa.t + (wa.b - wa.t - wh) // 2)
      this.hits := this.RunSearch("")   ; empty search = everything, for the initial group list
      this.BuildGroups()
      this.Arrange()   ; place the controls and the grid now (also syncs the DPI to the window's), so the render target is created at its final size
      this.InitD2D()
      this.Layout()
      this.ShowInfo()
      this.Render()
      this.edFilter.Focus()
      OnExit(this.SaveSize.Bind(this))
      this.starting := false
      DllCall("InvalidateRect", "Ptr", this.grid.Hwnd, "Ptr", 0, "Int", false)   ; one more paint now that everything has settled
      OnMessage(0x404, this.TrayMessage.Bind(this))
      this.tipTmr := ObjBindMethod(this, "TipTick")
      OnMessage(0x200, this.OnTipMove.Bind(this))   ; WM_MOUSEMOVE
   }
   /**
    * Tray message callback when icon is clicked, toggle the window visibility
    */
   Static TrayMessage(wParam, lParam, uMsg, hWnd) {
      Switch lParam {
         Case 0x201:   ; WM_LBUTTONDOWN user left-pressed tray icon
            ; Send "#{Tab}"
         Case 0x202:   ; WM_LBUTTONUP user left-released tray icon
            state := WinGetMinMax(this.Gui)
            Switch state {
               Case -1:
                  WinRestore(this.Gui)
                  this.Gui.show()
               Case 0, 1:
                  WinMinimize(this.Gui)
                  this.Gui.hide()
               Default:
            }
         Case 0x203:   ; WM_LBUTTONDBLCLK user double left-clicked tray icon
         Case 0x204:   ; WM_RBUTTONDOWN user right-pressed tray icon
         Case 0x205:   ; WM_RBUTTONUP user right-released tray icon
         Case 0x206:   ; WM_RBUTTONDBLCLK	Right double-click
         Case 0x207:   ; WM_MBUTTONDOWN	Middle button pressed
         Case 0x208:   ; WM_MBUTTONUP user middle-clicked tray icon
         Case 0x209:   ; WM_MBUTTONDBLCLK	Middle double-click
         Case 0x20A:   ; WM_MOUSEWHEEL	Mouse wheel rotated
         Default:
      }
   }

   ; ---------------------------------------------------------------- dark mode

   /**
    * Switch the process to force-dark mode via uxtheme ordinal 135 (SetPreferredAppMode).
    * Undocumented; requires Win10 1903+ and is silently ignored if unavailable.
    * @returns {unset?}
    */
   static InitDark() {
      ; uxtheme ordinal 135 = SetPreferredAppMode(ForceDark). Undocumented, Win10 1903+/Win11; ignored if absent.
      try {
         hMod := DllCall("LoadLibrary", "Str", "uxtheme", "Ptr")
         DllCall(DllCall("GetProcAddress", "Ptr", hMod, "Ptr", 135, "Ptr"), "Int", 2)
      }
   }

   /**
    * Enable the dark title bar on a top-level window (DWMWA_USE_IMMERSIVE_DARK_MODE, attribute 20, falling back to 19).
    * @param {Integer} hwnd Window handle
    * @returns {unset?}
    */
   static DarkTitle(hwnd) {   ; DWMWA_USE_IMMERSIVE_DARK_MODE: 20 (Win10 2004+/Win11), 19 (older Win10)
      for attr in [20, 19] {
         if !DllCall("dwmapi\DwmSetWindowAttribute", "Ptr", hwnd, "Int", attr, "Int*", 1, "Int", 4, "Int")
            break
      }
   }

   /**
    * Apply a dark visual theme to a control or window (also gives dark scrollbars).
    * @param {Integer} hwnd Control or window handle
    * @param {String} [theme="DarkMode_Explorer"] Theme name passed to SetWindowTheme
    * @returns {unset?}
    */
   static Dark(hwnd, theme := "DarkMode_Explorer") {
      DllCall("uxtheme\SetWindowTheme", "Ptr", hwnd, "Str", theme, "Ptr", 0)
   }

   ; ---------------------------------------------------------------- Direct2D

   /**
    * Builds a D2D1_COLOR_F (4 floats, RGBA) from a 0xRRGGBB value.
    * @param {Integer|String} rgb Color, 0xRRGGBB or a "RRGGBB" hex string.
    * @param {Number} [a=1.0] Alpha, 0.0 to 1.0.
    * @returns {Buffer} 16-byte D2D1_COLOR_F structure.
    */
   static _FloatColor(rgb, a := 1.0) {
      rgb := this._ToRGB(rgb)
      c := D2D1_COLOR_F()
      c.r := (rgb >> 16 & 0xFF) / 255
      c.g := (rgb >> 8 & 0xFF) / 255
      c.b := (rgb & 0xFF) / 255
      c.a := a
      return c
   }
      /**
    * Normalizes a color to an integer 0xRRGGBB.
    * @param {Integer|String} c An integer, or a hex string such as "A6ADC8" or "0xA6ADC8".
    * @returns {Integer}
    */
   static _ToRGB(c) {
      if c is Integer
         return c
      c := String(c)
      return Integer(SubStr(c, 1, 2) = "0x" ? c : "0x" c)
   }
   /**
    * Get the client area size of a window.
    * @param {Integer} hwnd Window handle
    * @param {VarRef} w Receives the client width in pixels
    * @param {VarRef} h Receives the client height in pixels
    * @returns {unset?}
    */
   static ClientSize(hwnd, &w, &h) {
      DllCall("GetClientRect", "Ptr", hwnd, RECT, rc := RECT())
      w := rc.right, h := rc.bottom
   }

   /**
    * Create the Direct2D and DirectWrite factories and the centered, non-wrapping 26-point Segoe UI text format,
    * then create the render target. Does nothing if already initialized.
    * @throws {OSError} If a factory cannot be created
    * @returns {unset?}
    */
   static InitD2D() {
      if this._d2d
         Return

      iid := Buffer(16)
      DllCall("ole32\CLSIDFromString", "Str", "{06152247-6F50-465A-9245-118BFD3B6007}", "Ptr", iid)   ; ID2D1Factory
      hr  := DllCall("d2d1\D2D1CreateFactory", "UInt", 0, "Ptr", iid, "Ptr", 0, "Ptr*", &f := 0, "Int")
      if hr || !f
         throw OSError(hr, , "D2D1CreateFactory")

      this._d2d := f

      iid := Buffer(16)
      DllCall("ole32\CLSIDFromString", "Str", "{B859EE5A-D838-4B5B-A2E8-1ADC7D93DB48}", "Ptr", iid)   ; IDWriteFactory
      hr := DllCall("dwrite\DWriteCreateFactory", "UInt", 0, "Ptr", iid, "Ptr*", &d:=0, "Int")
      if hr || !d
         throw OSError(hr, , "DWriteCreateFactory")

      this._dw := d
      this.MakeFallback()
      this.MakeFormat()
      this.MakeRT()
   }

   /**
    * Create (or recreate after a DPI change) the two centered, non-wrapping text formats: the regular font and the
    * emoji font. The render target is 96 dpi (1 DIP = 1 pixel), so the size is the DPI-scaled pixel size.
    * @returns {unset?}
    */
   static MakeFormat() {
      this.ClearLayoutCache()   ; cached layouts were built from the old formats
      for f in [this.fmt, this.fmtEmoji]
         if f
            ObjRelease(f)
      this.fmt := this.NewFormat(this.Font)
      this.fmtEmoji := this.NewFormat(this.EmojiFont)
   }

   /**
    * Release every cached text layout. Called when the cell size or the text formats change, and when the cache is full.
    * @returns {unset?}
    */
   static ClearLayoutCache() {
      for , c in this.lc
         ObjRelease(c.lay)
      this.lc.Clear()
   }

   /**
    * Create one centered, non-wrapping text format at the current DPI-scaled size.
    * @param {String} family Font family name
    * @returns {Integer} IDWriteTextFormat pointer. The caller owns it.
    */
   static NewFormat(family) {
      static iid := 0
      f := D2D.CreateTextFormat(this._dw, family, this.S(this.FontSize))
      D2D.SetTextAlignment(f, 2)        ; center
      D2D.SetParagraphAlignment(f, 2)   ; center
      D2D.SetWordWrapping(f, 1)         ; no wrap
      if this._fb {
         if !iid
            iid := Buffer(16), DllCall("ole32\CLSIDFromString", "Str", "{5F174B49-0D8B-4CFB-8BCA-F1CCE9D06C67}", "Ptr", iid)   ; IDWriteTextFormat1
         if !ComCall(0, f, "Ptr", iid, "Ptr*", &f1 := 0, "Int") {   ; QueryInterface
            try ComCall(34, f1, "Ptr", this._fb)                     ; IDWriteTextFormat1::SetFontFallback
            ObjRelease(f1)
         }
      }
      return f
   }

   static _fb := 0   ; IDWriteFontFallback: the system fallback plus the ini's extra fonts (0 = DirectWrite's default)

   /**
    * Build a custom font fallback from the "Fallback Fonts" ini setting (comma-separated family names, e.g.
    * "Symbola, Noto Sans Symbols 2"). DirectWrite's system fallback only knows a fixed list of Windows fonts, so
    * fonts the user installs are never used for substitution unless they are added here.
    * By default the extra fonts are tried after the system mappings (last resort); with "Fallback First=1" they
    * are tried before them. Either way the format's own font (Segoe UI) still wins for characters it has.
    * Needs Windows 8.1+ (IDWriteFactory2); on failure the default fallback is left in place.
    * @returns {unset?}
    */
   static MakeFallback() {
      list := IniRead(this.ini, "Settings", "Fallback Fonts", "`n")
      if list = "`n" {   ; key absent: write an empty one so it can be found and edited
         IniWrite("", this.ini, "Settings", "Fallback Fonts")
         return
      }
      if Trim(list) = ""
         return
      bufs := []
      for n in StrSplit(list, ",", " `t")
         if n != ""
            b := Buffer(StrPut(n)), StrPut(n, b), bufs.Push(b)
      if !bufs.Length   ; only separators, e.g. " , "
         return
      ptrs := Buffer(bufs.Length * A_PtrSize)
      for b in bufs
         NumPut("Ptr", b.Ptr, ptrs, (A_Index - 1) * A_PtrSize)
      first := IniRead(this.ini, "Settings", "Fallback First", 0)

      f2 := bld := sys := 0
      try {
         iid := Buffer(16)
         DllCall("ole32\CLSIDFromString", "Str", "{0439FC60-CA44-4994-8DEE-3A9AF7B732EC}", "Ptr", iid)   ; IDWriteFactory2
         ComCall(0, this._dw, "Ptr", iid, "Ptr*", &f2)           ; QueryInterface
         ComCall(26, f2, "Ptr*", &sys)                           ; IDWriteFactory2::GetSystemFontFallback
         ComCall(27, f2, "Ptr*", &bld)                           ; IDWriteFactory2::CreateFontFallbackBuilder
         rng := Buffer(8), NumPut("UInt", 0, "UInt", 0x10FFFF, rng)   ; DWRITE_UNICODE_RANGE: all of Unicode
         if !first
            ComCall(4, bld, "Ptr", sys)                          ; AddMappings(system fallback)
         ComCall(3, bld, "Ptr", rng, "UInt", 1                   ; AddMapping(ranges, count,
            , "Ptr", ptrs, "UInt", bufs.Length                   ;   families, count,
            , "Ptr", 0, "Ptr", 0, "Ptr", 0, "Float", 1.0)        ;   system collection, no locale, no base family, scale 1)
         if first
            ComCall(4, bld, "Ptr", sys)
         ComCall(5, bld, "Ptr*", &fb := 0)                       ; CreateFontFallback
         this._fb := fb
      }
      for p in [sys, bld, f2]
         if p
            ObjRelease(p)
   }

   /**
    * Text format for a string: the emoji font for emoji-range characters and sequences (no fallback search),
    * the regular font for everything else.
    * @param {String} s The string to be drawn
    * @returns {Integer} IDWriteTextFormat pointer
    */
   static PickFormat(s) => RegExMatch(s, "[\x{1F000}-\x{1FAFF}\x{2600}-\x{27BF}\x{FE0F}\x{200D}]") ? this.fmtEmoji : this.fmt

   /**
    * Create the HWND render target for the grid window (96 dpi, so 1 DIP = 1 pixel) and its solid color brush.
    * @returns {unset?}
    */
   static MakeRT() {
      this.ReleaseRT()
      this.ClientSize(this.grid.Hwnd, &w, &h)
      props := D2D1_RENDER_TARGET_PROPERTIES()
      props.dpiX := props.dpiY := 96   ; 1 DIP = 1 pixel
      hprops := D2D1_HWND_RENDER_TARGET_PROPERTIES()
      hprops.hwnd := this.grid.Hwnd
      hprops.pixelSize.width := Max(w, 1)
      hprops.pixelSize.height := Max(h, 1)
      hprops.presentOptions := 2   ; D2D1_PRESENT_OPTIONS_IMMEDIATELY: EndDraw does not wait for vsync
      this.rtW := w, this.rtH := h
      this.rt := D2D.CreateHwndRenderTarget(this._d2d, props, hprops)
      this.br := D2D.CreateSolidColorBrush(this.rt, this.clrGlyph)
   }

   /**
    * Draw the visible cells: borders, the selected cell highlight, then the glyphs (color emoji via ENABLE_COLOR_FONT).
    * If EndDraw fails (device lost) the render target is dropped and Recreate is scheduled.
    * @returns {unset?}
    */
   Static Render() {
      ; A nested Render (a paint arriving mid-frame) would call BeginDraw on a target that is already drawing, fail,
      ; and ReleaseRT the brush under the outer frame. Nested calls just ask the running frame to draw once more.
      if this.rendering {
         this.again := true
         return
      }
      this.rendering := true
      wasCritical := A_IsCritical
      Critical("On")   ; also keep timers (Recreate) and other threads from interrupting a frame
      try {
         Loop {
            this.again := false
            this.Draw()
         } Until !this.again
      } finally {
         this.rendering := false
         Critical(wasCritical)
      }
   }

   /**
    * Draw one frame. Call through Render, which makes the frame uninterruptible.
    * @returns {unset?}
    */
   Static Draw() {
      Static cbRecreate := ObjBindMethod(this, "Recreate")

      If !this.rt
         Return

      rt := this.rt, br := this.br, rect := this.rect, dw := this._dw
      cw := this.cellW, chh := this.cellH, cols := this.cols, top := this.top
      showB := this.chkBounds.value
      res := this.res, Ch := UniData.Ch, Fl := UniData.Fl
      n := res.Length
      lw := this.lw, hf := lw / 2   ; stroke width and half-pixel offset, in whole device pixels
      lc := this.lc
      if chh != this.lcH || lc.Count > 2000 {   ; layouts use a chh x chh box, so only DPI/font size invalidate them; cap the cache size
         this.ClearLayoutCache()
         this.lcH := chh
      }
      ox := (cw - chh) / 2   ; centers the square layout box in the cell (cw >= chh unless the grid is narrower than one cell)

      D2D.BeginDraw(rt)
      D2D.Clear(rt, this.clrBack)

      ; Loop over each character and display in a grid
      If n {
         first := top * cols + 1
         last := Min(n, (top + this.page + 1) * cols)
         count := last - first + 1

         If count > 0 {
            ; Initial grid position
            pos := first - 1
            col := Mod(pos, cols)
            row := pos // cols - top

            ; pass 1: cell borders, then the selected cell
            D2D.SetColor(br, this.clrCellBorder)

            Loop count {
               rect.left := col * cw + hf
               rect.top := row * chh + hf
               rect.right := (col + 1) * cw - hf
               rect.bottom := (row + 1) * chh - hf

               D2D.DrawRectangle(rt, rect, br, lw)

               ; Advance grid position
               If ++col = cols
                  col := 0, row++
            }
            ; Active selection (if applicable)
            If this.sel >= first && this.sel <= last {
               pos := this.sel - 1
               col := Mod(pos, cols)
               row := pos // cols - top

               rect.left := col * cw + hf
               rect.top := row * chh + hf
               rect.right := (col + 1) * cw - hf
               rect.bottom := (row + 1) * chh - hf

               D2D.SetColor(br, this.clrSelFill)
               D2D.FillRectangle(rt, rect, br)

               D2D.SetColor(br, this.clrSelBorder)
               D2D.DrawRectangle(rt, rect, br, lw * 1.5)
            }

            ; pass 2: glyphs (color glyphs ignore the brush). Layouts are cached per entry, so a selection change,
            ; scroll or resize only re-draws them; they are rebuilt only for entries not seen since the last cache reset.
            D2D.SetColor(br, this.clrGlyph)

            ; Reset grid position
            pos := first - 1
            col := Mod(pos, cols)
            row := pos // cols - top

            Loop count {
               e := res[first + A_Index - 1]
               if !(c := lc.Get(e, 0)) {
                  s := Ch[e]
                  If Fl[e] & 2
                     s := Chr(0x25CC) s
                  lay := D2D.CreateTextLayout(dw, s, this.PickFormat(s), chh, chh)
                  lc[e] := c := {lay: lay, m: 0}
               }
               ; options 6 = CLIP | ENABLE_COLOR_FONT
               D2D.DrawTextLayout(rt, col * cw + ox, row * chh, c.lay, br, 6)

               ; Advance grid position
               If ++col = cols
                  col := 0, row++
            }

            ; pass 3: text-box outlines from the cached metrics (one color change for the whole pass)
            If showB {
               D2D.SetColor(br, this.clrBounds)
               pos := first - 1
               col := Mod(pos, cols)
               row := pos // cols - top

               Loop count {
                  c := lc[res[first + A_Index - 1]]
                  if !c.m
                     c.m := D2D.GetMetrics(c.lay)
                  m := c.m
                  ; Advance x line height: the box the character occupies when inserted in a string
                  rect.left := col * cw + ox + m.left
                  rect.top := row * chh + m.top
                  rect.right := rect.left + m.widthIncludingTrailingWhitespace
                  rect.bottom := rect.top + m.height
                  D2D.DrawRectangle(rt, rect, br, lw)

                  If ++col = cols
                     col := 0, row++
               }
            }
         }
      }

      If D2D.EndDraw(rt) < 0 {   ; failed (device lost): rebuild and repaint
         this.ReleaseRT()
         SetTimer(cbRecreate, -50)
      }
   }   
   /**
    * Release the brush and render target if we have a reset
    */
   Static ReleaseRT() {
      if this.br
         ObjRelease(this.br)   ; brush first, it belongs to the target
      if this.rt
         ObjRelease(this.rt)
      this.br := this.rt := 0
   }
   /**
    * Rebuild the render target after a device-lost error and repaint.
    * @returns {unset?}
    */
   static Recreate() {
      if this.rendering {   ; never free the target mid-frame; try again shortly
         SetTimer(ObjBindMethod(this, "Recreate"), -50)
         return
      }
      this.MakeRT()
      this.Render()
   }

   ; ---------------------------------------------------------------- layout / scrolling

   /**
    * Recalculate columns, rows, page size and cell width from the grid's client size and result count,
    * clamp the scroll position and update the scrollbar.
    * @returns {unset?}
    */
   static Layout() {
      ; Showing/hiding the scrollbar (UpdateScroll) changes the client width, so measure again afterwards
      ; and redo the layout once if it moved.
      Loop 2 {
         this.ClientSize(this.grid.Hwnd, &w, &h)
         this.cellH := this.S(This.BlockSize)
         this.cols  := Max(1, w // this.S(this.BlockSize))
         this.cellW := w / this.cols
         this.rows  := Ceil(this.res.Length / this.cols)
         this.page  := Max(1, h // this.cellH)
         this.top   := Max(0, Min(this.top, this.rows - this.page))
         this.UpdateScroll()
         this.ClientSize(this.grid.Hwnd, &w2, &h2)
         if w2 = w && h2 = h
            break
      }
      this.SyncRT()
   }

   /**
    * Resize the render target if the grid's client size no longer matches it. A render target that is
    * out of step with its window leaves the uncovered part showing the window's own (white) background.
    * @returns {unset?}
    */
   static SyncRT() {
      if !this.rt
         return
      this.ClientSize(this.grid.Hwnd, &w, &h)
      if w = this.rtW && h = this.rtH
         return
      sz := D2D1_SIZE_U()
      sz.width := Max(w, 1), sz.height := Max(h, 1)
      D2D.Resize(this.rt, sz)
      this.rtW := w, this.rtH := h
   }

   /**
    * Push the current row range, page size and top row to the grid's vertical scrollbar.
    * @returns {unset?}
    */
   static UpdateScroll() {
      si := Buffer(28, 0)
      ; SIF_RANGE | SIF_PAGE | SIF_POS | SIF_DISABLENOSCROLL (keeps the client width stable)
      NumPut("UInt", 28, "UInt", 0xF, "Int", 0, "Int", Max(0, this.rows - 1), "UInt", this.page, "Int", this.top, si)
      DllCall("SetScrollInfo", "Ptr", this.grid.Hwnd, "Int", 1, "Ptr", si, "Int", true)
   }

   /**
    * Scroll so row t is the first visible row (clamped), then repaint. No-op if the position is unchanged.
    * @param {Integer} t Zero-based row index
    * @returns {unset?}
    */
   static ScrollTo(t) {
      t := Max(0, Min(t, this.rows - this.page))
      if t = this.top
         return
      this.top := t
      this.UpdateScroll()
      this.Render()
   }

   /**
    * Scroll the grid by mouse wheel, three rows per notch.
    * @param {Integer} dir -1 to scroll up, 1 to scroll down
    * @returns {unset?}
    */
   static Wheel(dir) {
      this.ScrollTo(this.top + dir * 3)
   }

   /**
    * Check whether the main window is the active window.
    * @returns {Integer} Non-zero if the main window is active, otherwise 0
    */
   static Active() => this.main && WinActive("ahk_id " this.main.Hwnd)

   /**
    * Move the selection by dx cells / dy rows and scroll it into view. The first key press selects the first
    * visible cell; moving down from above a short last row lands on the final cell.
    * @param {Integer} dx Cells to move horizontally
    * @param {Integer} dy Rows to move vertically
    * @returns {unset?}
    */
   static Nav(dx, dy) {
      n := this.res.Length
      if !n
         return
      if !this.sel
         this.sel := Min(n, this.top * this.cols + 1)   ; first key press selects the first visible cell
      else {
         s := this.sel + dx + dy * this.cols
         if s < 1 || s > n {
            if dy > 0 && Ceil(this.sel / this.cols) < this.rows
               s := n   ; down from above a short last row: land on the final cell
            else
               return
         }
         this.sel := s
      }
      row := (this.sel - 1) // this.cols
      if row < this.top
         this.top := row
      else if row >= this.top + this.page
         this.top := row - this.page + 1
      this.top := Max(0, Min(this.top, this.rows - this.page))
      this.UpdateScroll()
      this.ShowInfo()
      this.Render()
   }

   /**
    * Check whether the mouse is over the grid window (used as the #HotIf condition for the wheel hotkeys).
    * @returns {Boolean}
    */
   static OverGrid() {
      if !this.grid
         return false
      MouseGetPos(, , , &h, 2)
      return h = this.grid.Hwnd
   }

   /**
    * Gui Size event: lay the window out again. The event's width and height are ignored because they are in
    * DPI-scaled units for a +DPIScale Gui; Arrange reads the real client size in pixels.
    * @param {Gui} gui The main GUI
    * @param {Integer} minMax -1 minimized, 0 restored, 1 maximized
    * @param {Integer} w New client width (DPI-scaled units, unused)
    * @param {Integer} h New client height (DPI-scaled units, unused)
    * @returns {unset?}
    */
   static OnSize(gui, minMax, w, h) {
      If minMax = -1 {
         ; Dramatically reduce/prune memory when minimizing
         DllCall("psapi\EmptyWorkingSet", "ptr", -1)
         Return
      }
      this.Arrange()
   }

   /**
    * Position every control and the grid window from the 72-dpi design values, in physical pixels at the
    * window's current DPI, then recalculate the grid layout (which also resizes the render target).
    * Everything is absolute, so it can be called at any time: after a resize, after a DPI change, at startup.
    * @returns {unset?}
    */
   static Arrange() {
      if !this.grid
         return
      this.ApplyDPI(DllCall("GetDpiForWindow", "Ptr", this.main.Hwnd, "UInt"))   ; the window's DPI is the truth
      this.ClientSize(this.main.Hwnd, &w, &h)   ; physical pixels
      if !w || !h
         return
      pad := this.S(8), topH := this.S(44), botH := this.S(72), mw := this.S(230)
      navW := this.S(28), navGap := this.S(3), rowH := this.S(28), filterX := pad + 2 * (navW + navGap)
      chkH := this.S(15), chkY := pad + (rowH - chkH) // 2   ; fixed design height: never read back from the control
      cpW := this.S(80)
      rx := w - pad - this.S(92), bx := rx - this.S(88), sx := bx - this.S(96)
      by := h - botH + this.S(6), bh := botH - this.S(10)
      lstW := this.S(170), gx := pad + lstW + pad   ; group list on the left, grid fills the rest
      midH := Max(1, h - topH - botH)
      ; Use deferred batch updates so we don't get controls wiping each other out on resize
      items := [
         [this.btnBack,    pad, pad, navW, rowH],
         [this.btnForward, pad + navW + navGap, pad, navW, rowH],
         [this.edFilter,   filterX, pad, Max(1, sx - pad - filterX - navGap - navW), rowH],
         [this.btnClear,   sx - pad - navW, pad, navW, rowH],
         [this.chkSkin,    sx, chkY, this.S(96), chkH],
         [this.chkBounds,  bx, chkY, this.S(88), chkH],
         [this.chkRecents, rx, chkY, this.S(92), chkH],
         [this.lstGroup,   pad, topH, lstW, midH],
         [this.grid,       gx, topH, Max(1, w - gx), midH],
         [this.txtInfo,    pad, by, Max(1, w - pad * 4 - cpW - mw), bh],
         [this.txtMetrics, w - pad * 2 - cpW - mw, by, mw, bh],
         [this.btnCopy,    w - pad - cpW, by, cpW, this.S(30)]
      ]

      hdwp := DllCall("BeginDeferWindowPos", "Int", items.Length, "Ptr")
      for it in items {
         if !hdwp
            break
         ; The returned handle can change, so always reassign it. 0x14 = SWP_NOZORDER | SWP_NOACTIVATE
         hdwp := DllCall("DeferWindowPos", "Ptr", hdwp, "Ptr", it[1].Hwnd, "Ptr", 0
            , "Int", it[2], "Int", it[3], "Int", it[4], "Int", it[5], "UInt", 0x14, "Ptr")
      }
      if hdwp
         DllCall("EndDeferWindowPos", "Ptr", hdwp)
      else   ; batch failed (the handle is already invalid): individual moves, in pixels (GuiCtrl.Move would DPI-scale them)
         for it in items
            DllCall("SetWindowPos", "Ptr", it[1].Hwnd, "Ptr", 0, "Int", it[2], "Int", it[3], "Int", it[4], "Int", it[5], "UInt", 0x14)
      if this.rt
         this.Layout()   ; re-lays out the grid (and resizes the render target)
   }
   /**
    * Measure an entry with DirectWrite, using the grid's text format and the same square layout box the grid draws with.
    * Also reports the font(s) DirectWrite actually picked for it, font fallback included.
    * @param {Integer} e Entry index
    * @returns {Object} {M: DWRITE_TEXT_METRICS, O: DWRITE_OVERHANG_METRICS, F: font family name(s)}
    */
   static CharMetrics(e) {
      s := UniData.Ch[e]
      skip := 0
      if UniData.Fl[e] & 2
         s := Chr(0x25CC) s, skip := 1   ; ignore the dotted-circle carrier when naming the font
      lay := D2D.CreateTextLayout(this._dw, s, this.PickFormat(s), this.cellH, this.cellH)
      f := this.FontsUsed(lay, skip)
      m := D2D.GetMetrics(lay)
      D2D.SetMaxWidth(lay, m.widthIncludingTrailingWhitespace)   ; box = the advance
      D2D.SetMaxHeight(lay, m.height)                            ; and the line height
      o := D2D.GetOverhangMetrics(lay)
      ObjRelease(lay)
      return {M: m, O: o, F: f}
   }

   ; ---------------------------------------------------------------- font detection

   static _fr := 0, _frVt := 0, _frNames := [], _frSkip := 0, _coll := 0

   /**
    * Font family name(s) DirectWrite actually uses to draw a text layout, font fallback included. The layout is
    * "drawn" through a minimal custom IDWriteTextRenderer that paints nothing; DrawGlyphRun receives the font face
    * of each glyph run. A run whose glyphs are all glyph 0 (.notdef, the empty box) is marked "(missing)".
    * @param {Integer} lay IDWriteTextLayout pointer
    * @param {Integer} skip Leading UTF-16 units to ignore (e.g. a dotted-circle carrier)
    * @returns {String} e.g. "Segoe UI Symbol", or "Segoe UI + Cambria Math"
    */
   static FontsUsed(lay, skip := 0) {
      if !this._fr {
         vt := this._frVt := Buffer(10 * A_PtrSize)
         cbs := [
            CallbackCreate(this._FrQI.Bind(this), , 3),                                       ; QueryInterface
            CallbackCreate((p) => 1, , 1),                                                    ; AddRef (static object)
            CallbackCreate((p) => 1, , 1),                                                    ; Release
            CallbackCreate((p, ctx, pb) => (NumPut("Int", 1, pb), 0), , 3),                   ; IsPixelSnappingDisabled
            CallbackCreate((p, ctx, pm) => (NumPut("Float", 1, "Float", 0, "Float", 0, "Float", 1, "Float", 0, "Float", 0, pm), 0), , 3),  ; GetCurrentTransform
            CallbackCreate((p, ctx, pf) => (NumPut("Float", 1, pf), 0), , 3),                 ; GetPixelsPerDip
            CallbackCreate(this._FrGlyphRun.Bind(this), , 8),                                 ; DrawGlyphRun
            CallbackCreate((p*) => 0, , 6),                                                   ; DrawUnderline
            CallbackCreate((p*) => 0, , 6),                                                   ; DrawStrikethrough
            CallbackCreate((p*) => 0, , 8)                                                    ; DrawInlineObject
         ]
         for cb in cbs
            NumPut("Ptr", cb, vt, (A_Index - 1) * A_PtrSize)
         this._fr := Buffer(A_PtrSize)
         NumPut("Ptr", vt.Ptr, this._fr)
      }
      if !this._coll
         ComCall(3, this._dw, "Ptr*", &c := 0, "Int", false)   ; IDWriteFactory::GetSystemFontCollection
         , this._coll := c
      this._frNames := [], this._frSkip := skip
      try ComCall(58, lay, "Ptr", 0, "Ptr", this._fr, "Float", 0, "Float", 0)   ; IDWriteTextLayout::Draw
      out := ""
      for n in this._frNames
         out .= (A_Index > 1 ? " + " : "") n
      return out != "" ? out : "(unknown font)"
   }

   /**
    * Renderer QueryInterface: answer only IUnknown, IDWritePixelSnapping and IDWriteTextRenderer, so DirectWrite
    * never treats this object as an IDWriteTextRenderer1 (whose larger vtable it does not have).
    */
   static _FrQI(p, riid, ppv) {
      static ok := "{00000000-0000-0000-C000-000000000046}|{EAF3A2DA-ECF4-4D24-B644-B34F6842024B}|{EF8A8135-5CC6-45FE-8825-C5A0724EB819}"
      buf := Buffer(80)
      DllCall("ole32\StringFromGUID2", "Ptr", riid, "Ptr", buf, "Int", 40)
      if InStr(ok, StrGet(buf)) {
         NumPut("Ptr", p, ppv)
         return 0
      }
      NumPut("Ptr", 0, ppv)
      return 0x80004002   ; E_NOINTERFACE
   }

   /**
    * Renderer DrawGlyphRun: record the family name of the run's font face. Slots 3/4 (baseline x/y) are floats
    * passed in XMM registers on x64 and are not used, so their values do not matter.
    */
   static _FrGlyphRun(p, ctx, bx, by, mode, run, desc, effect) {
      try {
         ; DWRITE_GLYPH_RUN_DESCRIPTION: localeName, string, stringLength, clusterMap, textPosition
         len := NumGet(desc, 2 * A_PtrSize, "UInt")
         pos := NumGet(desc, 3 * A_PtrSize + (A_PtrSize = 8 ? 8 : 4), "UInt")
         if pos + len <= this._frSkip
            return 0
         ; DWRITE_GLYPH_RUN: fontFace, fontEmSize, glyphCount, glyphIndices, ...
         face := NumGet(run, 0, "Ptr")
         cnt := NumGet(run, A_PtrSize + 4, "UInt")
         gi := NumGet(run, A_PtrSize + 8, "Ptr")
         missing := cnt > 0
         Loop cnt
            if NumGet(gi, (A_Index - 1) * 2, "UShort") {
               missing := false
               break
            }
         name := "(unknown font)"
         if !ComCall(6, this._coll, "Ptr", face, "Ptr*", &font := 0, "Int") {   ; GetFontFromFontFace
            ComCall(3, font, "Ptr*", &fam := 0)                                ; IDWriteFont::GetFontFamily
            ComCall(6, fam, "Ptr*", &ls := 0)                                  ; IDWriteFontFamily::GetFamilyNames
            ComCall(4, ls, "Str", "en-us", "UInt*", &idx := 0, "Int*", &found := 0)   ; FindLocaleName
            idx := found ? idx : 0
            ComCall(7, ls, "UInt", idx, "UInt*", &n := 0)                      ; GetStringLength
            VarSetStrCapacity(&name, n + 1)
            ComCall(8, ls, "UInt", idx, "Str", name, "UInt", n + 1)            ; GetString
            ObjRelease(ls), ObjRelease(fam), ObjRelease(font)
         }
         if missing
            name .= " (missing)"
         for x in this._frNames
            if x = name
               return 0
         this._frNames.Push(name)
      }
      return 0
   }
   ; ---------------------------------------------------------------- messages

   /**
    * WM_PAINT handler: repaint the grid and validate its update region.
    * @param {Gui} gui The grid window
    * @param {Integer} wParam Unused
    * @param {Integer} lParam Unused
    * @param {Integer} msg Message number
    * @returns {Integer} 0
    */
   static OnPaint(gui, wParam, lParam, msg) {
      this.Render()
      DllCall("ValidateRect", "Ptr", gui.Hwnd, "Ptr", 0)
      return 0
   }

   /**
    * WM_ERASEBKGND handler: suppress background erase on the grid to avoid flicker.
    * @param {Gui} gui The grid window
    * @param {Integer} wParam Unused
    * @param {Integer} lParam Unused
    * @param {Integer} msg Message number
    * @returns {Integer} 1
    */
   static OnErase(gui, wParam, lParam, msg) => 1

   /**
    * WM_VSCROLL handler: translate scrollbar actions (line, page, thumb drag, top, bottom) into a scroll.
    * @param {Gui} gui The grid window
    * @param {Integer} wParam Low word = scroll code, high word = thumb position
    * @param {Integer} lParam Unused
    * @param {Integer} msg Message number
    * @returns {Integer} 0
    */
   static OnVScroll(gui, wParam, lParam, msg) {
      code := wParam & 0xFFFF, pos := (wParam >> 16) & 0xFFFF
      switch code {
         case 0: t := this.top - 1
         case 1: t := this.top + 1
         case 2: t := this.top - this.page
         case 3: t := this.top + this.page
         case 4, 5: t := pos
         case 6: t := 0
         case 7: t := this.rows
         default: return 0
      }
      this.ScrollTo(t)
      return 0
   }

   /**
    * WM_LBUTTONDOWN handler: select the cell under the cursor and update the info text and display.
    * @param {Gui} gui The grid window
    * @param {Integer} wParam Unused
    * @param {Integer} lParam Low word = x, high word = y (client coordinates)
    * @param {Integer} msg Message number
    * @returns {Integer} 0
    */
   static OnClick(gui, wParam, lParam, msg) {
      x := lParam & 0xFFFF, y := (lParam >> 16) & 0xFFFF
      idx := (this.top + y // this.cellH) * this.cols + Floor(x / this.cellW) + 1
      if idx > this.res.Length
         return 0
      this.sel := idx
      this.ShowInfo()
      this.Render()
      return 0
   }

   ; ---------------------------------------------------------------- filter / info

   /**
    * Filter edit Change event: debounce typing by scheduling Refilter in 200 ms.
    * @returns {unset?}
    */
   static OnFilter(*) {
      if this.navigatingHistory
         return
      SetTimer(this.tmr, strlen(Trim(this.edFilter.Value)) > 2 ? -220: -600)   ; debounce typing (200 ms)
   }
   /**
    * Clear the filter edit and immediately apply the empty search.
    * The cleared value is not recorded in the history.
    * @returns {unset?}
    */
   static ClearFilter(*) {
      SetTimer(this.tmr, 0)   ; cancel any pending debounced search
      this.navigatingHistory := true
      try {
         this.edFilter.Value := ""
      } finally {
         this.navigatingHistory := false
      }
      this.ApplySearch("")
   }

   /**
    * Clear button Click handler: same as Ctrl+Backspace in the filter box, then return focus to it.
    * @returns {unset?}
    */
   static OnClearClick(*) {
      this.ClearFilter()
      this.edFilter.Focus()
   }

   /**
    * Return true only when the filter edit currently owns keyboard focus.
    * Used to scope Ctrl+Backspace so it does not affect other controls.
    * @returns {Boolean}
    */
   static FilterFocused() {
      return this.Active() && DllCall("GetFocus", "Ptr") = this.edFilter.Hwnd
   }

   /**
    * Run the search for the current filter text (showing nothing when empty), reset selection and scroll,
    * then relayout and repaint. Also used as the skin-tone checkbox Click handler.
    * @returns {unset?}
    */
   static Refilter(*) {
      text := Trim(this.edFilter.Value)
      if !this.navigatingHistory
         this.RecordHistory(text)
      this.ApplySearch(text)
   }

   /**
    * Apply a search string to the grid, resetting selection and scroll before repainting.
    * Kept separate from Refilter so history navigation can apply an entry without recording it again.
    * @param {String} text Search string
    * @returns {unset?}
    */
   static ApplySearch(text) {
      this.sel := 0, this.top := 0
      this.filterText := text
      if this.chkRecents.Value
         this.res := this.RecentList()
      else {
         this.hits := this.RunSearch(text)   ; empty text = everything: feeds the group counts
         this.BuildGroups()
         this.ApplyGroup()
      }
      this.Layout()
      this.ShowInfo()
      this.Render()
   }

   /**
    * Search for text with the current hide-skin setting, as cheaply as possible:
    * - Empty text: the full list is computed once per skin setting and reused.
    * - Text that extends the previous search (same skin setting, no OR): every new term contains an old term, so
    *   the new matches are a subset of the previous hits and only those are searched. Excluded when the previous
    *   text ends in a lone "u", because that plain term can grow into a "u+" code point term, which tests the
    *   code point text instead of the name and so is not a narrowing.
    * - Anything else: a full search.
    * this.hits must still hold the results for lastText (ApplySearch assigns the return value to it).
    * @param {String} text Trimmed search string
    * @returns {Array} Entry indexes of all matches, in data order. Treat as read-only (it may be shared).
    */
   static RunSearch(text) {
      skin := this.chkSkin.Value
      if text = "" {
         if !this.allHits.Has(skin)
            this.allHits[skin] := UniData.Search("", skin)
         hits := this.allHits[skin]
      } else if skin = this.lastSkin && this.lastText != ""
         && SubStr(text, 1, StrLen(this.lastText)) == this.lastText
         && !InStr(text, "OR", true) && !RegExMatch(this.lastText, "i)(^|\s)u$")
         hits := UniData.Search(text, skin, this.hits)
      else
         hits := UniData.Search(text, skin)
      this.lastText := text, this.lastSkin := skin
      return hits
   }

   /**
    * Add a distinct, non-blank search string to the history. A new search after Back discards the forward branch.
    * Blank searches are never stored.
    * @param {String} text Search string
    * @returns {unset?}
    */
   static RecordHistory(text) {
      if text = ""
         return
      if this.historyPos && this.searchHistory[this.historyPos] = text
         return
      while this.searchHistory.Length > this.historyPos
         this.searchHistory.Pop()

      this.searchHistory.Push(text)
      this.historyPos := this.searchHistory.Length
      this.UpdateHistoryButtons()
   }

   /**
    * Navigate backward or forward through previously applied search strings.
    * A pending edit is committed before navigation, and the target entry is immediately applied.
    * @param {Integer} direction -1 for Back, 1 for Forward
    * @returns {unset?}
    */
   static NavigateHistory(direction, *) {
      SetTimer(this.tmr, 0)   ; cancel a pending debounced search
      text := Trim(this.edFilter.Value)
      offList := text = "" && this.historyPos   ; a blank box is not in the history: it sits just past the current entry
      if !offList && (!this.historyPos || text != this.searchHistory[this.historyPos])
         this.RecordHistory(text)
      target := offList ? (direction < 0 ? this.historyPos : 0) : this.historyPos + direction
      if target < 1 || target > this.searchHistory.Length {
         this.ApplySearch(text)
         this.UpdateHistoryButtons()
         return
      }
      this.historyPos := target
      this.navigatingHistory := true
      try {
         this.edFilter.Value := this.searchHistory[target]
      } finally {
         this.navigatingHistory := false
      }
      this.ApplySearch(this.searchHistory[target])
      this.UpdateHistoryButtons()
   }

   /**
    * Enable Back and Forward only when the corresponding history entries exist.
    * @returns {unset?}
    */
   static UpdateHistoryButtons() {
      if !this.btnBack
         return
      rec := this.chkRecents && this.chkRecents.Value
      this.btnBack.Enabled := !rec && this.historyPos > 1
      this.btnForward.Enabled := !rec && this.historyPos > 0 && this.historyPos < this.searchHistory.Length
   }
   /**
    * User toggled the show bounds check box
    * @returns {unset?}
    */
   static OnBounds(*) {
      this.Render()
   }
   /**
    * Rebuild the group list from the current search hits: "All" plus every group that has at least one hit,
    * with its count. Emoji groups come first, then Unicode blocks in code point order (data order).
    * The selected group is kept if it still has hits, otherwise the selection falls back to All.
    * Choose does not raise the Change event, so this never re-enters OnGroup.
    * The ListBox is only refilled when the items differ from what it already shows.
    * @returns {unset?}
    */
   static BuildGroups() {
      cnt := Map(), order := []
      Gr := UniData.Gr
      for i in this.hits {
         g := Gr[i] != "" ? Gr[i] : "(ungrouped)"
         if cnt.Has(g)
            cnt[g]++
         else {
            cnt[g] := 1
            order.Push(g)
         }
      }
      items := ["All (" this.hits.Length ")"], keys := [""], sig := items[1]
      for g in order {
         items.Push(g " (" cnt[g] ")")
         keys.Push(g)
         sig .= "`n" items[items.Length]
      }
      pos := 1
      if this.grpSel != "" {
         for k, v in keys {
            if v == this.grpSel {
               pos := k
               break
            }
         }
         if pos = 1
            this.grpSel := ""
      }
      lb := this.lstGroup
      this.grpKeys := keys
      if sig == this.grpSig {   ; same groups and counts: keep the list, only fix the selection
         if lb.Value != pos
            lb.Choose(pos)
         return
      }
      this.grpSig := sig
      lb.Opt("-Redraw")
      lb.Delete()
      lb.Add(items)
      lb.Choose(pos)
      lb.Opt("+Redraw")
   }

   /**
    * Build the grid results from the search hits and the selected group. With no group, the hits are
    * shown as is, and an empty filter shows nothing.
    * @returns {unset?}
    */
   static ApplyGroup() {
      if this.grpSel = "" {
         this.res := this.filterText = "" ? [] : this.hits
         return
      }
      Gr := UniData.Gr, key := this.grpSel, out := []
      for i in this.hits {
         if (Gr[i] != "" ? Gr[i] : "(ungrouped)") == key
            out.Push(i)
      }
      this.res := out
   }

   /**
    * Group list Change event: restrict the grid to the chosen group (or All) without redoing the search.
    * @returns {unset?}
    */
   static OnGroup(*) {
      v := this.lstGroup.Value
      if !v
         return
      this.grpSel := this.grpKeys[v]
      this.sel := 0, this.top := 0
      this.ApplyGroup()
      this.Layout()
      this.ShowInfo()
      this.Render()
   }

   /**
    * Show Recents toggled: disable the filter edit and group list while on, then rebuild the grid.
    * Refilter commits any pending debounced filter text first.
    * @returns {unset?}
    */
   static OnRecents(*) {
      SetTimer(this.tmr, 0)
      this.edFilter.Enabled := this.lstGroup.Enabled := this.btnClear.Enabled := !this.chkRecents.Value
      this.UpdateHistoryButtons()
      this.Refilter()
      if this.edFilter.Enabled
         this.edFilter.Focus()
   }

   /**
    * Recent copies as entry indexes, latest first.
    * @returns {Array}
    */
   static RecentList() {
      out := []
      n := this.recent.Length
      Loop n
         out.Push(this.recent[n - A_Index + 1])
      return out
   }

   /**
    * Push a copied entry onto the history (moving it to the latest slot if already present),
    * trim to maxRecent and save.
    * @param {Integer} i Entry index
    * @returns {unset?}
    */
   static AddRecent(i) {
      r := this.recent
      for k, v in r {
         if v = i {
            r.RemoveAt(k)
            break
         }
      }
      r.Push(i)
      while r.Length > this.maxRecent
         r.RemoveAt(1)
      this.SaveRecent()
   }

   /**
    * Write the history to the ini as comma separated hex code points, oldest first.
    * A multi code point glyph is joined with "-", e.g. 1F468-200D-1F469.
    * @returns {unset?}
    */
   static SaveRecent() {
      list := ""
      for i in this.recent {
         s := UniData.Ch[i], p := 1, cps := ""
         while p <= StrLen(s) {
            cp := Ord(SubStr(s, p, 2))
            cps .= (cps = "" ? "" : "-") Format("{:X}", cp)
            p += cp > 0xFFFF ? 2 : 1
         }
         list .= (list = "" ? "" : ",") cps
      }
      try IniWrite(list, this.ini, "Settings", "history")
   }

   /**
    * Read the history back from the ini. Unknown or malformed tokens are skipped.
    * @returns {unset?}
    */
   static LoadRecent() {
      this.recent := []
      for tok in StrSplit(IniRead(this.ini, "Settings", "history", ""), ",") {
         s := ""
         try {
            for h in StrSplit(Trim(tok), "-")
               s .= Chr(Integer("0x" h))
         } catch
            continue
         if s != "" && (i := UniData.Idx.Get(StrReplace(s, UniData.VS16), 0))
            this.recent.Push(i)
      }
      while this.recent.Length > this.maxRecent
         this.recent.RemoveAt(1)
   }
   /**
    * Update the info text: name, code points, group and keywords of the selected entry, or a status message
    * (prompt, match count, or no matches) when nothing is selected.
    * @returns {unset?}
    */
   Static ShowInfo() {
      If this.sel {
         i := this.res[this.sel]
         kw := Trim(UniData.Kw[i])
         If StrLen(kw) > 140
            kw := SubStr(kw, 1, 140) "..."
         grp := UniData.Gr[i] != "" ? "   |   " UniData.Gr[i] : ""
         ob := this.CharMetrics(i)
         this.txtInfo.Value := UniData.Nm[i] "   |   " ob.F "`n" UniData.Hx[i] grp "`n" kw
         m := ob.M, O := ob.O
         this.txtMetrics.Value := Format("Left {:.1f}   Top {:.1f}`nWidth {:.1f}   Trailing {:.1f}`nHeight {:.1f}   Lines {}`nOverhang {:.1f} x {:.1f}"
            , m.left, m.top, m.width, m.widthIncludingTrailingWhitespace, m.height, m.lineCount, -O.left, -O.right)

      } Else If this.chkRecents.Value {
         this.txtInfo.Value := this.res.Length ? this.res.Length " recent characters" : "No recent characters"
         this.txtMetrics.Value := ""
      } Else If Trim(this.edFilter.Value) = "" && this.grpSel = ""
         this.txtInfo.Value := "Type in the filter box or pick a group."
      Else {
         this.txtInfo.Value := this.res.Length ? this.res.Length " matching characters" : "No matches"
         this.txtMetrics.Value := ""
      }
   }
   /**
    * Global WM_MOUSEMOVE handler: when the mouse is over txtInfo, start the tooltip timer.
    * @param {Integer} wParam Unused
    * @param {Integer} lParam Unused
    * @param {Integer} msg Message number
    * @param {Integer} hwnd Window or control that received the message
    * @returns {unset?}
    */
   static OnTipMove(wParam, lParam, msg, hwnd) {
      if hwnd != this.txtInfo.Hwnd || this.tipT0
         return
      this.tipT0 := A_TickCount, this.tipShown := false
      SetTimer(this.tipTmr, 50)
   }

   /**
    * Timer: show the tip once the mouse has rested on txtInfo for 400 ms, and remove it when the mouse leaves.
    * Uses tooltip number 2 so it never collides with the "Copied" tooltip.
    * @returns {unset?}
    */
   static TipTick() {
      MouseGetPos(, , , &h, 2)
      if h != this.txtInfo.Hwnd {
         SetTimer(this.tipTmr, 0)
         ToolTip(, , , 2)
         this.tipT0 := 0
      } else if !this.tipShown && A_TickCount - this.tipT0 >= 400 {
         this.tipShown := true
         ToolTip("Click: filter by this character's group`nRight-click: copy the code point", , , 2)
      }
   }   
   /**
    * When clicking the text at the bottom, filter on the group
    * @param GuiOrCtrlObj Gui control
    * @returns {unset?} 
    */
   Static pickGroup(GuiOrCtrlObj, *) {
      If this.sel {
         i := this.res[this.sel]
         group := UniData.Gr[i]
         this.lstGroup.Enabled := this.edFilter.Enabled := this.btnClear.Enabled := true
         this.edFilter.value := group
         If (this.chkRecents) {
            ; Want history to point at the last entry
         }
         this.chkRecents.Value := false
         this.OnFilter()
      }
   }
   /**
    * Copy the next code for the seleced character into the clipboard
    * @param GuiOrCtrlObj Gui control
    * @returns {unset?} 
    */
   Static getInfo(GuiOrCtrlObj, *) {
      If this.sel {
         i := this.res[this.sel]
         A_Clipboard := UniData.Hx[i]
         ToolTip("Copied " A_Clipboard " to clipboard")
         SetTimer(ToolTip, -1200)
      }
   }
   /**
    * Grid double-click / right-click handler: copy the selected character.
    * @returns {unset?}
    */
   static CopySel(*) {
      this.CopySelected()
   }
   /**
    * Copy the selected character (or the first result if none is selected) to the clipboard and show a tooltip.
    * Also the Copy button Click handler.
    * @returns {unset?}
    */
   Static CopySelected(*) {
      if !this.res.Length
         return
      i := this.res[this.sel ? this.sel : 1]
      A_Clipboard := UniData.Ch[i]
      this.AddRecent(i)
      ToolTip("Copied: " UniData.Nm[i])
      SetTimer(ToolTip, -1200)
   }
   /**
    * Read a saved client dimension from the ini (stored in 72-dpi design units, see SaveSize) and convert it to
    * the 96-dpi units a +DPIScale Gui expects, so the result does not depend on the current DPI.
    * @param {String} key "Width" or "Height"
    * @param {Integer} def Default, in 72-dpi design units
    * @param {Integer} min Smallest accepted saved value, in 72-dpi design units
    * @returns {Integer} Size for Gui.Show, in DPI-scaled (96-dpi) units
    */
   static LoadDim(key, def, min) {
      v := IniRead(this.ini, "Window", key, "")
      return Round((IsInteger(v) && v >= min ? v : def) * 96 / 72)
   }

   /**
    * OnExit handler: save the client size to the ini. Skipped while minimized or maximized so the
    * last normal size is kept.
    */
   static SaveSize(*) {
      try {
         if WinGetMinMax(this.main.Hwnd) != 0
            return
         WinGetClientPos(, , &w, &h, this.main.Hwnd)
         IniWrite(Round(w / this.sc), this.ini, "Window", "Width")
         IniWrite(Round(h / this.sc), this.ini, "Window", "Height")
         IniWrite(this.chkBounds.value,this.ini,"Settings","Show Bounds")
         IniWrite(this.chkSkin.value,this.ini,"Settings","Hide Skin Tones")
         IniWrite(this.FontSize, this.ini, "Settings", "Font Size")
      }
   }   
   /**
    * Set a window's title bar / taskbar icon from an .ico file, at the sizes the current DPI needs.
    * @param {Integer} hwnd Window handle
    * @param {String} file Path to the .ico
    * @returns {unset?}
    */
   ; static SetWindowIcon(hwnd, file) {
   ;    for type, m in Map(1, [11, 12], 0, [49, 50]) {   ; ICON_BIG: SM_CXICON/SM_CYICON, ICON_SMALL: SM_CXSMICON/SM_CYSMICON
   ;       cx := DllCall("GetSystemMetricsForDpi", "Int", m[1], "UInt", this.dpi, "Int")
   ;       cy := DllCall("GetSystemMetricsForDpi", "Int", m[2], "UInt", this.dpi, "Int")
   ;       hIcon := DllCall("LoadImageW", "Ptr", 0, "Str", file, "UInt", 1, "Int", cx, "Int", cy, "UInt", 0x10, "Ptr")   ; IMAGE_ICON, LR_LOADFROMFILE
   ;       if hIcon
   ;          if prev := SendMessage(0x80, type, hIcon, hwnd)   ; WM_SETICON returns the previous icon
   ;             DllCall("DestroyIcon", "Ptr", prev)
   ;    }
   ; }
}

UniBrowser.Start()

#HotIf UniBrowser.OverGrid()
WheelUp::UniBrowser.Wheel(-1)
WheelDown::UniBrowser.Wheel(1)
Left::UniBrowser.Nav(-1, 0)
Right::UniBrowser.Nav(1, 0)
Up::UniBrowser.Nav(0, -1)
Down::UniBrowser.Nav(0, 1)
#HotIf

; Arrow keys move the selection while the window is active, even with focus in the filter box
; (Ctrl+Left/Right, Home/End, etc. still edit the filter text).
#HotIf UniBrowser.FilterFocused()
^Backspace::UniBrowser.ClearFilter()
#HotIf

; #HotIf UniBrowser.Active()
; #HotIf
