   /**
    * Release the brush and render target if we have a reset
    */
   Static ReleaseRT() {
      if this.br
         ObjRelease(this.br)   ; brush first, it belongs to the target
      if this.rt
         ObjRelease(this.rt)
      this.br := this.rt := 0
   }
   /**
    * Rebuild the render target after a device-lost error and repaint.
    * @returns {unset?}
    */
   static Recreate() {
      this.MakeRT()
      this.Render()
   }

   ; ---------------------------------------------------------------- layout / scrolling

   /**
    * Recalculate columns, rows, page size and cell width from the grid's client size and result count,
    * clamp the scroll position and update the scrollbar.
    * @returns {unset?}
    */
   static Layout() {
      this.ClientSize(this.grid.Hwnd, &w, &h)
      this.cellH := this.S(56)
      this.cols := Max(1, w // this.S(56))
      this.cellW := w / this.cols
      this.rows := Ceil(this.res.Length / this.cols)
      this.page := Max(1, h // this.cellH)
      this.top := Max(0, Min(this.top, this.rows - this.page))
      this.UpdateScroll()
   }

   /**
    * Push the current row range, page size and top row to the grid's vertical scrollbar.
    * @returns {unset?}
    */
   static UpdateScroll() {
      si := Buffer(28, 0)
      ; SIF_RANGE | SIF_PAGE | SIF_POS | SIF_DISABLENOSCROLL (keeps the client width stable)
      NumPut("UInt", 28, "UInt", 0xF, "Int", 0, "Int", Max(0, this.rows - 1), "UInt", this.page, "Int", this.top, si)
      DllCall("SetScrollInfo", "Ptr", this.grid.Hwnd, "Int", 1, "Ptr", si, "Int", true)
   }

   /**
    * Scroll so row t is the first visible row (clamped), then repaint. No-op if the position is unchanged.
    * @param {Integer} t Zero-based row index
    * @returns {unset?}
    */
   static ScrollTo(t) {
      t := Max(0, Min(t, this.rows - this.page))
      if t = this.top
         return
      this.top := t
      this.UpdateScroll()
      this.Render()
   }

   /**
    * Scroll the grid by mouse wheel, three rows per notch.
    * @param {Integer} dir -1 to scroll up, 1 to scroll down
    * @returns {unset?}
    */
   static Wheel(dir) {
      this.ScrollTo(this.top + dir * 3)
   }

   /**
    * Check whether the main window is the active window.
    * @returns {Integer} Non-zero if the main window is active, otherwise 0
    */
   static Active() => this.main && WinActive("ahk_id " this.main.Hwnd)

   /**
    * Move the selection by dx cells / dy rows and scroll it into view. The first key press selects the first
    * visible cell; moving down from above a short last row lands on the final cell.
    * @param {Integer} dx Cells to move horizontally
    * @param {Integer} dy Rows to move vertically
    * @returns {unset?}
    */
   static Nav(dx, dy) {
      n := this.res.Length
      if !n
         return
      if !this.sel
         this.sel := Min(n, this.top * this.cols + 1)   ; first key press selects the first visible cell
      else {
         s := this.sel + dx + dy * this.cols
         if s < 1 || s > n {
            if dy > 0 && Ceil(this.sel / this.cols) < this.rows
               s := n   ; down from above a short last row: land on the final cell
            else
               return
         }
         this.sel := s
      }
      row := (this.sel - 1) // this.cols
      if row < this.top
         this.top := row
      else if row >= this.top + this.page
         this.top := row - this.page + 1
      this.top := Max(0, Min(this.top, this.rows - this.page))
      this.UpdateScroll()
      this.ShowInfo()
      this.Render()
   }

   /**
    * Check whether the mouse is over the grid window (used as the #HotIf condition for the wheel hotkeys).
    * @returns {Boolean}
    */
   static OverGrid() {
      if !this.grid
         return false
      MouseGetPos(, , , &h, 2)
      return h = this.grid.Hwnd
   }

   /**
    * Gui Size event: reposition the controls and grid, resize the render target and recalculate the layout.
    * @param {Gui} gui The main GUI
    * @param {Integer} minMax -1 minimized, 0 restored, 1 maximized
    * @param {Integer} w New client width
    * @param {Integer} h New client height
    * @returns {unset?}
    */
   static OnSize(gui, minMax, w, h) {
      static renderCB := this.Render.bind(this)
      if minMax = -1
         return
      pad := this.S(8), topH := this.S(44), botH := this.S(72)
      this.edFilter.Move(pad, pad, w - pad * 3 - this.S(150), this.S(28))
      this.chkSkin.Move(w - pad - this.S(150), pad + this.S(4), this.S(150))
      this.grid.Move(0, topH, w, Max(1, h - topH - botH))
      mw := this.S(230)
      this.txtInfo.Move(pad, h - botH + this.S(6), w - pad * 4 - this.S(80) - mw, botH - this.S(10))
      this.txtMetrics.Move(w - pad * 2 - this.S(80) - mw, h - botH + this.S(6), mw, botH - this.S(10))      
      this.btnCopy.Move(w - pad - this.S(80), h - botH + this.S(6), this.S(80), this.S(30))
      if this.rt {
         this.ClientSize(this.grid.Hwnd, &gw, &gh)
         sz := D2D1_SIZE_U()
         sz.width := Max(gw, 1), sz.height := Max(gh, 1)
         D2D.Resize(this.rt, sz)
         this.Layout()
         ; BUG, Render seems to start some sort of cycle that hangs. Even if on a SetTimer with delay, doesn't seem necessary
         ; this.Render()
      }
   }
   /**
    * Measure an entry with DirectWrite, using the grid's text format and a cell-sized layout box.
    * @param {Integer} e Entry index
    * @returns {DWRITE_TEXT_METRICS}
    */
   static CharMetrics(e) {
      s := UniData.Ch[e]
      if UniData.Fl[e] & 2
         s := Chr(0x25CC) s
      lay := D2D.CreateTextLayout(this._dw, s, this.fmt, this.cellW, this.cellH)
      m := D2D.GetMetrics(lay)
      D2D.SetMaxWidth(lay, m.widthIncludingTrailingWhitespace)   ; box = the advance
      D2D.SetMaxHeight(lay, m.height)                            ; and the line height
      o := D2D.GetOverhangMetrics(lay)
      ObjRelease(lay)
      return {M: m, O: o}
   }
   ; ---------------------------------------------------------------- messages

   /**
    * WM_PAINT handler: repaint the grid and validate its update region.
    * @param {Integer} wParam Unused
    * @param {Integer} lParam Unused
    * @param {Integer} msg Message number
    * @param {Integer} hwnd Window that received the message
    * @returns {Integer?} 0 when handled for the grid window, otherwise unset
    */
   static OnPaint(wParam, lParam, msg, hwnd) {
      if hwnd != this.grid.Hwnd
         return
      this.Render()
      DllCall("ValidateRect", "Ptr", hwnd, "Ptr", 0)
      return 0
   }

   /**
    * WM_ERASEBKGND handler: suppress background erase on the grid to avoid flicker.
    * @param {Integer} wParam Unused
    * @param {Integer} lParam Unused
    * @param {Integer} msg Message number
    * @param {Integer} hwnd Window that received the message
    * @returns {Integer?} 1 when handled for the grid window, otherwise unset
    */
   static OnErase(wParam, lParam, msg, hwnd) {
      if hwnd = this.grid.Hwnd
         return 1
   }

   /**
    * WM_VSCROLL handler: translate scrollbar actions (line, page, thumb drag, top, bottom) into a scroll.
    * @param {Integer} wParam Low word = scroll code, high word = thumb position
    * @param {Integer} lParam Unused
    * @param {Integer} msg Message number
    * @param {Integer} hwnd Window that received the message
    * @returns {Integer?} 0 when handled for the grid window, otherwise unset
    */
   static OnVScroll(wParam, lParam, msg, hwnd) {
      if hwnd != this.grid.Hwnd
         return
      code := wParam & 0xFFFF, pos := (wParam >> 16) & 0xFFFF
      switch code {
         case 0: t := this.top - 1
         case 1: t := this.top + 1
         case 2: t := this.top - this.page
         case 3: t := this.top + this.page
         case 4, 5: t := pos
         case 6: t := 0
         case 7: t := this.rows
         default: return 0
      }
      this.ScrollTo(t)
      return 0
   }

   /**
    * WM_LBUTTONDOWN handler: select the cell under the cursor and update the info text and display.
    * @param {Integer} wParam Unused
    * @param {Integer} lParam Low word = x, high word = y (client coordinates)
    * @param {Integer} msg Message number
    * @param {Integer} hwnd Window that received the message
    * @returns {Integer?} 0 when handled for the grid window, otherwise unset
    */
   static OnClick(wParam, lParam, msg, hwnd) {
      if hwnd != this.grid.Hwnd
         return
      x := lParam & 0xFFFF, y := (lParam >> 16) & 0xFFFF
      idx := (this.top + y // this.cellH) * this.cols + Floor(x / this.cellW) + 1
      if idx > this.res.Length
         return 0
      this.lastIdx := idx, this.lastClick := A_TickCount
      this.sel := idx
      this.ShowInfo()
      this.Render()
      return 0
   }

   ; ---------------------------------------------------------------- filter / info

   /**
    * Filter edit Change event: debounce typing by scheduling Refilter in 150 ms.
    * @returns {unset?}
    */
   static OnFilter(*) {
      SetTimer(this.tmr, -150)   ; debounce typing
   }

   /**
    * Run the search for the current filter text (showing nothing when empty), reset selection and scroll,
    * then relayout and repaint. Also used as the skin-tone checkbox Click handler.
    * @returns {unset?}
    */
   static Refilter(*) { 
      text := Trim(this.edFilter.Value)
      this.sel := 0, this.top := 0
      this.res := text = "" ? [] : UniData.Search(text, this.chkSkin.Value)
      this.Layout()
      this.ShowInfo()
      this.Render()
   }

   /**
    * Update the info text: name, code points, group and keywords of the selected entry, or a status message
    * (prompt, match count, or no matches) when nothing is selected.
    * @returns {unset?}
    */
   Static ShowInfo() {
      If this.sel {
         i := this.res[this.sel]
         kw := Trim(UniData.Kw[i])
         If StrLen(kw) > 140
            kw := SubStr(kw, 1, 140) "..."
         grp := UniData.Gr[i] != "" ? "   |   " UniData.Gr[i] : ""
         this.txtInfo.Value := UniData.Nm[i] "`n" UniData.Hx[i] grp "`n" kw
         ob := this.CharMetrics(i)
         m := ob.M, O := ob.O
         this.txtMetrics.Value := Format("Left {:.1f}   Top {:.1f}`nWidth {:.1f}   Trailing {:.1f}`nHeight {:.1f}   Lines {}`nOverhang {:.1f} x {:.1f}"
            , m.left, m.top, m.width, m.widthIncludingTrailingWhitespace, m.height, m.lineCount, -O.left, -O.right)

      } Else If Trim(this.edFilter.Value) = ""
         this.txtInfo.Value := "Type in the filter box to show characters."
      Else {
         this.txtInfo.Value := this.res.Length ? this.res.Length " matching characters" : "No matches"
         this.txtMetrics.Value := ""
      }
   }

   /**
    * Copy the selected character (or the first result if none is selected) to the clipboard and show a tooltip.
    * @returns {unset?}
    */
   Static CopyEnter(*) {
      this.CopySelected()
   }
   static CopySel(GuiOrCtrlObj, wParam, lParam, msg) {
      Switch GuiOrCtrlObj {
         Case this.grid :
            this.CopySelected()
         Default :
      }
   }
   Static CopySelected(*) {
      if !this.res.Length
         return
      i := this.res[this.sel ? this.sel : 1]
      A_Clipboard := UniData.Ch[i]
      ToolTip("Copied: " UniData.Nm[i])
      SetTimer(ToolTip, -1200)
   }
}

UniBrowser.Start()

#HotIf UniBrowser.OverGrid()
WheelUp::UniBrowser.Wheel(-1)
WheelDown::UniBrowser.Wheel(1)
#HotIf

; Arrow keys move the selection while the window is active, even with focus in the filter box
; (Ctrl+Left/Right, Home/End, etc. still edit the filter text).
#HotIf UniBrowser.Active()
Left::UniBrowser.Nav(-1, 0)
Right::UniBrowser.Nav(1, 0)
Up::UniBrowser.Nav(0, -1)
Down::UniBrowser.Nav(0, 1)
#HotIf

